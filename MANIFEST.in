include *.md LICENSE pyproject.toml MANIFEST.in avtool.py requirements-*.txt
recursive-include avevidence *.py *.json
recursive-include tests *.py
recursive-include scripts *.py *.sh *.ps1
recursive-include docs *.md *.json *.txt
recursive-include schemas *.json
recursive-include examples *.md *.json
recursive-include LICENSES *
recursive-include .github/workflows *.yml *.yaml
prune wheelhouse
prune dependency-sources
prune reports
prune runs
prune cache
prune models
prune media
prune downloads
prune .venv
prune .cloud-runtime
global-exclude __pycache__ *.py[cod] .env .env.* *.whl *.zip *.mkv *.mp4 *.flac *.wav *.sqlite
