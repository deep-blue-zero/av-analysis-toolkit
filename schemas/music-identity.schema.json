{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ave.music-identity.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "audio_stream": {
          "type": "integer",
          "minimum": 0
        },
        "clock": {
          "const": "original_pts_minus_source_origin"
        },
        "interval_seconds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "alias",
        "sha256",
        "display_name",
        "audio_stream",
        "clock",
        "interval_seconds"
      ]
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "ave.music-identity.lookup.v1"
          },
          "query_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "alias": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "audio_stream": {
                "type": "integer",
                "minimum": 0
              },
              "clock": {
                "const": "original_pts_minus_source_origin"
              },
              "interval_seconds": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "alias",
              "sha256",
              "display_name",
              "audio_stream",
              "clock",
              "interval_seconds"
            ]
          },
          "submission_class": {
            "enum": [
              "LOCAL_ONLY",
              "DERIVED_FINGERPRINT_LOOKUP",
              "REMOTE_MEDIA_LOOKUP"
            ]
          },
          "media_uploaded": {
            "const": false
          },
          "fingerprint_sent": {
            "type": "boolean"
          },
          "duration_sent": {
            "type": "boolean"
          },
          "authorization": {
            "enum": [
              "NOT_REQUIRED_LOCAL",
              "EXPLICIT_EXTERNAL_LOOKUP"
            ]
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "SUPPORTED",
              "CANDIDATE",
              "AMBIGUOUS",
              "CONTRADICTED",
              "UNRESOLVED",
              "NOT_TESTED"
            ]
          },
          "fingerprint_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "queried_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 1000
          },
          "normalized_metadata": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "maxItems": 1000
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "maxItems": 1000
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "external_request_performed": {
            "type": "boolean"
          },
          "test_double": {
            "type": "boolean"
          },
          "requested_recording_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "metadata_retrieved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "observation_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "schema",
          "query_id",
          "provider",
          "source",
          "submission_class",
          "media_uploaded",
          "fingerprint_sent",
          "duration_sent",
          "authorization",
          "status",
          "fingerprint_sha256",
          "queried_at",
          "candidate_ids",
          "normalized_metadata",
          "missing_fields",
          "reason"
        ]
      },
      "maxItems": 400
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "level": {
            "enum": [
              "RECORDING",
              "PERFORMANCE",
              "ARRANGEMENT",
              "COMPOSITION",
              "PHRASE",
              "UNKNOWN"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "artist": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "album": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "isrc": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "musicbrainz_recording_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "musicbrainz_work_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "maxItems": 100
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "provider_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "provider_native_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "score_is_probability": {
            "const": false
          },
          "lookup_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "query_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "query_interval_seconds": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fingerprint_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "relation": {
            "type": [
              "object",
              "null"
            ]
          },
          "status": {
            "const": "CANDIDATE"
          }
        },
        "required": [
          "candidate_id",
          "level",
          "title",
          "artist",
          "album",
          "isrc",
          "musicbrainz_recording_id",
          "musicbrainz_work_ids",
          "provider",
          "provider_id",
          "provider_native_score",
          "score_is_probability",
          "lookup_basis",
          "query_id",
          "query_interval_seconds",
          "fingerprint_sha256",
          "relation",
          "status"
        ]
      },
      "maxItems": 1000
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema": {
            "const": "ave.music-identity.family.v1"
          },
          "family_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 1000
          },
          "work_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "status": {
            "enum": [
              "CANDIDATE",
              "SUPPORTED"
            ]
          },
          "composition_scope": {
            "enum": [
              "PARTIAL_OR_MEDLEY",
              "QUERY_INTERVAL_CANDIDATE"
            ]
          },
          "recording_identity_status": {
            "const": "UNRESOLVED"
          },
          "score_aggregation": {
            "const": "NONE"
          },
          "proposed_composition_status": {
            "enum": [
              "CANDIDATE",
              "SUPPORTED_REQUIRES_ADJUDICATION"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "identity_level": {
            "const": "COMPOSITION"
          },
          "canonical_title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "candidate_recordings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          },
          "supporting_providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          },
          "adjudication_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "schema",
          "family_id",
          "candidate_ids",
          "work_id",
          "basis",
          "status",
          "composition_scope",
          "recording_identity_status",
          "score_aggregation",
          "proposed_composition_status",
          "reason",
          "identity_level",
          "canonical_title",
          "candidate_recordings",
          "supporting_providers",
          "adjudication_evidence_ids"
        ]
      },
      "maxItems": 1000
    },
    "correspondences": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 1000
    },
    "reference_comparisons": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 10
    },
    "adjudication": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "level": {
            "enum": [
              "RECORDING",
              "PERFORMANCE",
              "ARRANGEMENT",
              "COMPOSITION",
              "PHRASE",
              "UNKNOWN"
            ]
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "SUPPORTED",
              "CANDIDATE",
              "AMBIGUOUS",
              "CONTRADICTED",
              "UNRESOLVED",
              "NOT_TESTED"
            ]
          },
          "candidate_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 1000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 1000
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "family_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "level",
          "status",
          "candidate_ids",
          "evidence_ids",
          "reviewer",
          "reason"
        ]
      },
      "maxItems": 6
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 1000
    },
    "network_activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "external_requests": {
          "type": "integer",
          "minimum": 0
        },
        "media_uploads": {
          "const": 0
        },
        "paid_calls": {
          "const": 0
        }
      },
      "required": [
        "external_requests",
        "media_uploads",
        "paid_calls"
      ]
    },
    "privacy": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 1000
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "relationship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "sha256",
        "schema",
        "relationship"
      ]
    }
  },
  "required": [
    "schema",
    "source",
    "queries",
    "candidates",
    "families",
    "correspondences",
    "reference_comparisons",
    "adjudication",
    "unresolved",
    "network_activity",
    "privacy",
    "evidence"
  ]
}
